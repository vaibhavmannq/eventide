{
  "name": "eventide",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "check": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit -p packages/ledger && tsc --noEmit -p packages/db && tsc --noEmit -p packages/api && tsc --noEmit -p scripts",
    "test": "vitest run",
    "test:db": "vitest run -c vitest.db.config.ts",
    "db:migrate": "node --experimental-strip-types --no-warnings packages/db/src/cli.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@types/node": "24.13.4",
    "@types/pg": "^8.23.1",
    "fast-check": "4.10.2",
    "pg": "^8.23.1",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
