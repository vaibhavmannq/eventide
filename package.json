{
  "name": "eventide",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "check": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit -p packages/ledger && tsc --noEmit -p packages/db && tsc --noEmit -p packages/api && tsc --noEmit -p packages/web && tsc --noEmit -p scripts",
    "test": "vitest run",
    "test:db": "vitest run -c vitest.db.config.ts",
    "db:migrate": "node --experimental-strip-types --no-warnings packages/db/src/cli.ts",
    "e2e": "playwright test",
    "dev": "npm run build -w @eventide/web && npm run dev -w @eventide/api",
    "load": "node --experimental-strip-types --no-warnings scripts/proof/load.ts",
    "crash": "node --experimental-strip-types --no-warnings scripts/proof/crash.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "^1.64.1",
    "@types/node": "26.6.5",
    "@types/pg": "^8.23.1",
    "fast-check": "4.10.2",
    "pg": "^8.23.1",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
