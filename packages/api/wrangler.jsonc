{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "eventide",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  // node-postgres needs Node's net, crypto and buffer modules, which Workers provide with this flag.
  "compatibility_flags": ["nodejs_compat"],

  // The app's files. /api/* always reaches the Worker; any other path is a file, or index.html for app routes.
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  },

  // Created with: npx wrangler hyperdrive create eventide --connection-string="<Neon, as eventide_api>"
  // The id is not a secret; the connection string lives only in Cloudflare.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "997b270675d7454a9a572cdc78aade0f",
      "localConnectionString": "postgres://eventide_api_dev:eventide_api_dev@localhost:5432/eventide_dev"
    }
  ],

  // Run the Worker next to the database (Neon, AWS Singapore), not next to the visitor: a write is about a dozen
  // round trips to Postgres and only one to the visitor.
  "placement": { "region": "aws:ap-southeast-1" },

  // Abuse limits (free; they only count as the requests they guard). Generous for real people: a busy session is
  // a few requests a minute. Approximate by design: counted per Cloudflare location, synced within seconds.
  "ratelimits": [
    { "name": "RL_IP", "namespace_id": "1001", "simple": { "limit": 300, "period": 60 } },
    { "name": "RL_USER", "namespace_id": "1002", "simple": { "limit": 120, "period": 60 } }
  ],

  // Anyone can make an account: the owner shares the app (and its Android and Windows downloads) with people they
  // know (2026-10-26). Set to "closed" to go back to invite links and ALLOWED_EMAILS only (docs/DEPLOY.md).
  "vars": { "SIGNUPS": "open" },

  "triggers": { "crons": ["17 3 * * *"] },
  "observability": { "enabled": true }
}
