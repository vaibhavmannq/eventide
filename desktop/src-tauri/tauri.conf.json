{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Eventide",
  "version": "0.1.0",
  "identifier": "io.github.vaibhavmannq.eventide",
  "build": { "frontendDist": "../static" },
  "app": {
    "windows": [],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "appimage", "deb"],
    "publisher": "Vaibhav Mann",
    "shortDescription": "Split costs, settle up, rest.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "nsis": { "installMode": "currentUser" }
    },
    "linux": {
      "deb": { "section": "utils", "desktopTemplate": "eventide.desktop" },
      "appimage": { "bundleMediaFramework": false }
    }
  },
  "plugins": {
    "deep-link": { "desktop": { "schemes": ["eventide"] } }
  }
}
